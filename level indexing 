import pandas as pd
data={
    'A':[1,2,3],
    'B':[4,5,6],
    'C':[7,8,9]
}
df=pd.DataFrame(data)
print("Single level indexing",df)
a=[['high','high','med','med','low','low'],['one','two','one','two','one','two']]
index=pd.MultiIndex.from_arrays(a,names=('first','second'))
da={'A':[1,2,3,4,5,6],'B':[7,8,9,10,11,12]}
dfh=pd.DataFrame(da,index=index)
print("Heirarchical level indexing",dfh)